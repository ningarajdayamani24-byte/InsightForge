# Use a long, random value before deployment. Never commit the real values.
SESSION_SECRET=replace-with-a-long-random-secret

# Development only: replace this immediately. For production, prefer ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=change-this-password

# Optional production password hash. Generate it with:
# node -e "const c=require('crypto'); const s=c.randomBytes(16).toString('hex'); console.log('scrypt$'+s+'$'+c.scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
# ADMIN_PASSWORD_HASH=scrypt$your-salt$your-derived-key

PORT=3000
NODE_ENV=development
